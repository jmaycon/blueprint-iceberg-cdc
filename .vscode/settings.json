{
    "java.configuration.Maven.userSettings": "./.m2/settings.xml",
    "maven.terminal.customEnv": [
        {
            "environmentVariable": "MAVEN_OPTS",
            "value": "--add-exports=java.base/sun.nio.ch=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED"
        }
    ],
    "java.jdt.ls.vmargs": "--add-exports=java.base/sun.nio.ch=ALL-UNNAMED",
    "java.configuration.updateBuildConfiguration": "interactive",
    "java.debug.settings.onBuildFailureProceed": true,
    "java.compile.nullAnalysis.mode": "automatic"
}
